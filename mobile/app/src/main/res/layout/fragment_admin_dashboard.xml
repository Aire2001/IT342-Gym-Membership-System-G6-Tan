<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFB">

    <!-- Tab bar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="2dp" />

    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" android:layout_marginTop="40dp" />

    <!-- Overview tab -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tab_overview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:text="Admin Dashboard" android:textSize="20sp" android:textStyle="bold" android:textColor="#111827" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" />
            <TextView android:text="Overview of your gym system" android:textSize="13sp" android:textColor="#6B7280" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:elevation="2dp" android:radius="12dp" android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView android:text="TOTAL REVENUE" android:textSize="9sp" android:textStyle="bold" android:textColor="#6B7280" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tv_revenue" android:text="₱0" android:textSize="20sp" android:textStyle="bold" android:textColor="#1D4ED8" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Completed only" android:textSize="10sp" android:textColor="#3B82F6" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:elevation="2dp" android:radius="12dp" android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView android:text="MEMBERS" android:textSize="9sp" android:textStyle="bold" android:textColor="#6B7280" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tv_members" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#7C3AED" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Regular users" android:textSize="10sp" android:textColor="#8B5CF6" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:elevation="2dp" android:radius="12dp" android:layout_marginEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView android:text="COMPLETED" android:textSize="9sp" android:textStyle="bold" android:textColor="#6B7280" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tv_completed" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#059669" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:elevation="2dp" android:radius="12dp" android:layout_marginStart="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                        <TextView android:text="PLANS" android:textSize="9sp" android:textStyle="bold" android:textColor="#6B7280" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tv_plans_count" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#D97706" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView android:text="Recent Payments" android:textSize="15sp" android:textStyle="bold" android:textColor="#111827" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_payments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView android:text="Recent Users" android:textSize="15sp" android:textStyle="bold" android:textColor="#111827" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Users tab -->
    <LinearLayout android:id="@+id/tab_users" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone" android:padding="16dp">
        <TextView android:id="@+id/tv_users_title" android:text="Users" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" />
        <EditText
            android:id="@+id/et_search_users"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Search by name, email, role…"
            android:textSize="13sp"
            android:background="@android:color/white"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:inputType="text" />
        <TextView
            android:id="@+id/tv_empty_users"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingVertical="32dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_users" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Payments tab -->
    <LinearLayout android:id="@+id/tab_payments" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone" android:padding="16dp">
        <TextView android:id="@+id/tv_payments_title" android:text="Payments" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" />
        <EditText
            android:id="@+id/et_search_payments"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Search by reference, user, plan…"
            android:textSize="13sp"
            android:background="@android:color/white"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:inputType="text" />
        <TextView
            android:id="@+id/tv_empty_payments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingVertical="32dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_admin_payments" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Plans tab -->
    <LinearLayout android:id="@+id/tab_plans" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <TextView android:id="@+id/tv_plans_title" android:text="Plans" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_plan" android:layout_width="wrap_content" android:layout_height="36dp" android:text="+ Add Plan" android:textSize="12sp" style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_plans" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
