<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="2dp"
    android:radius="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_initials" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="#1D4ED8" android:background="#DBEAFE" android:layout_marginEnd="12dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#111827" />
                <TextView android:id="@+id/tv_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#6B7280" />
                <TextView android:id="@+id/tv_joined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#9CA3AF" />
            </LinearLayout>
            <TextView android:id="@+id/tv_role" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:paddingHorizontal="10dp" android:paddingVertical="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_edit_role" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:text="Edit Role" android:textSize="12sp" android:layout_marginEnd="6dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:text="Delete" android:textSize="12sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:strokeColor="#DC2626" android:textColor="#DC2626" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
